# Android / Gradle
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/key.properties
android/app/release/
*.apk
*.aab
*.keystore
*.jks
# Exception: debug.keystore is needed for CI to sign release APKs
!android/app/debug.keystore

# OptoBuildSecret — NEVER commit. Per-build, regenerated.
android/app/src/main/java/com/optobot/native/OptoBuildSecret.kt

# Encrypted model assets — large, rebuilt per release
android/app/src/main/assets/_raw/
android/app/src/main/assets/opto_core.bin
android/app/src/main/assets/opto_meta.bin
android/app/src/main/assets/opto_key.hint

# User-provided model files — gitignored, never committed. Drop your
# model.onnx + tokenizer.json here before building.
_model_raw/*.onnx
_model_raw/*.onnx.data
_model_raw/*.json
!_model_raw/README.md

# Node
node_modules/
dist/
.webpack-cache/
.expo/
.expo-shared/

# IDE
.idea/
*.iml
.vscode/
*.swp

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.pyc
